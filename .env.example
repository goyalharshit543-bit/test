# ============================================================
#  Smart Drone Delivery — configuration
#  Copy this file to ".env" and edit the values you need.
# ============================================================

# ── Server ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
HOST=0.0.0.0
PORT=8000

# ── Admin account (created automatically on first run) ───────
ADMIN_NAME=Main Admin
ADMIN_EMAIL=admin@skycart.com
ADMIN_PASSWORD=admin123

# ── Demo shopkeeper account (created on first run) ───────────
SHOPKEEPER_NAME=Ravi Kumar
SHOPKEEPER_EMAIL=shop@skycart.com
SHOPKEEPER_PASSWORD=shop123

# ── Shop / drone home base ───────────────────────────────────
SHOP_NAME=SkyCart Central Store
SHOP_LAT=12.9716
SHOP_LNG=77.5946

# ── Drone fleet & simulation ─────────────────────────────────
DRONE_COUNT=3
# Cruise speed in metres/second (~12 m/s ≈ 43 km/h)
DRONE_SPEED_MPS=12
# Multiply the whole simulation clock (2 = 2x faster demo)
SIM_SPEED=1

# ── Google Maps (frontend tracking map) ──────────────────────
# Get a free key: https://console.cloud.google.com → Maps JavaScript API
# Leave empty to use the built-in OpenStreetMap/Leaflet fallback map.
GOOGLE_MAPS_API_KEY=

# ── AI assistant (LangChain) ─────────────────────────────────
# auto = try Gemini → OpenAI → Ollama → built-in fallback
AI_PROVIDER=auto
# Option 1: Google Gemini (free API key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Option 2: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Option 3: local Ollama (run `ollama serve` + `ollama pull llama3.1`)
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# ── Database (created automatically) ─────────────────────────
# DB_PATH=data/drone_delivery.db
